    "pro.blurb": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An app that charges a subscription to track subscriptions is a punchline. Bade Pro is bought once and yours."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "needs_review",
            "value": "აპლიკაცია, რომელიც გამოწერას ითხოვს გამოწერების თვალყურისთვის, სასაცილოა. Bade Pro ერთხელ იყიდება და შენია."
          }
        }
      }
    },
